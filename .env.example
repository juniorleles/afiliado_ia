# Copie para .env.local (gitignored — nunca commitar segredo de verdade).

# ---------------------------------------------------------------------------
# PUBLIC (safe to expose in HTML/canonical tags; still do not commit prod values
# if they reveal an unreleased domain you want private)
# ---------------------------------------------------------------------------
# Canonical https origin. Required in production. Alias: APP_BASE_URL.
# PUBLIC_SITE_URL=https://example.com
# APP_BASE_URL=https://example.com
# PUBLIC_SITE_NAME=Product Reviews
# PUBLIC_CONTACT_EMAIL=contact@example.com
# Mild health/supplement disclaimer on public reviews. Default: on.
# PUBLIC_HEALTH_DISCLAIMER=true

# ---------------------------------------------------------------------------
# SERVER_ONLY
# ---------------------------------------------------------------------------
# Production protections (lab/visual-frame closed, admin auth required,
# fatal env validation) turn on only when AIA_ENV=production.
# NODE_ENV=production alone does not enable them.
# AIA_ENV=development
# Required when AIA_ENV=production (names only — never commit real values):
#   AIA_ENV
#   PUBLIC_SITE_URL
#   CLICKBANK_INS_SECRET
#   ADMIN_PASSWORD
#   ADMIN_SESSION_SECRET
#   INTERNAL_FRAME_SECRET
# Optional:
#   PUBLIC_CONTACT_EMAIL
#   PUBLIC_SITE_NAME
# PRESELL_OS_DB=data/presell-os.db
# PRESELL_OS_MEDIA=data/product-images
# MEDIA_STORAGE=LOCAL
# VISUAL_QA_BASE_URL=http://localhost:3000
# Applitools Eyes. Set only in the environment or .env.local. Never commit a real key.
# APPLITOOLS_API_KEY=
# Public cloud default is https://eyes.applitools.com. Set this only for a private cloud.
# APPLITOOLS_SERVER_URL=https://eyes.applitools.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=

# ---------------------------------------------------------------------------
# SECRET (never NEXT_PUBLIC_*; never log; never put in client bundles)
# ---------------------------------------------------------------------------
# Fase 6 — "Gerar com IA". https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Visual concept engine. Server-side only. Never NEXT_PUBLIC_OPENAI_API_KEY.
# Image calls happen only after an explicit admin confirmation.
# OPENAI_API_KEY=
# VISUAL_CONCEPT_MODEL=gpt-image-2.5-flare
# VISUAL_MASTER_MODEL=gpt-image-2.5-sunburst

# Phase 5 — ClickBank INS v8. Register POST https://YOUR_DOMAIN/api/clickbank/ins
CLICKBANK_INS_SECRET=

# Phase 9 — single-operator admin. Required in production.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# INTERNAL_FRAME_SECRET=

# Optional web search used only after the original product URL is blocked
# (HTTP 403 / access denied / robots / anti-bot). Never used to bypass that URL.
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_PROVIDER=serpapi
# WEB_SEARCH_PROVIDER=none
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# Market research freshness for strategy selection (hours). Default 24.
# MARKET_RESEARCH_MAX_AGE_HOURS=24

# Object storage (only when MEDIA_STORAGE=OBJECT_STORAGE)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Google Ads OAuth. Names only — never commit real values.
# The operator connects in Configurações → Integrações → Google Ads.
# Do not paste a refresh token. The consent screen stores it encrypted.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/configuracoes/integracoes/google-ads/retorno
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_CLOUD_PROJECT=
