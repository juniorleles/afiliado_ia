# Copie para .env.local (gitignored — nunca commitar segredo de verdade).

# ---------------------------------------------------------------------------
# PUBLIC (safe to expose in HTML/canonical tags; still do not commit prod values
# if they reveal an unreleased domain you want private)
# ---------------------------------------------------------------------------
# Canonical https origin. Required in production. Alias: APP_BASE_URL.
# PUBLIC_SITE_URL=https://example.com
# APP_BASE_URL=https://example.com
# PUBLIC_SITE_NAME=Product Reviews
# PUBLIC_CONTACT_EMAIL=contact@example.com
# Mild health/supplement disclaimer on public reviews. Default: on.
# PUBLIC_HEALTH_DISCLAIMER=true

# ---------------------------------------------------------------------------
# SERVER_ONLY
# ---------------------------------------------------------------------------
# AIA_ENV=development
# PRESELL_OS_DB=data/presell-os.db
# PRESELL_OS_MEDIA=data/product-images
# MEDIA_STORAGE=LOCAL
# VISUAL_QA_BASE_URL=http://localhost:3000
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=

# ---------------------------------------------------------------------------
# SECRET (never NEXT_PUBLIC_*; never log; never put in client bundles)
# ---------------------------------------------------------------------------
# Fase 6 — "Gerar com IA". https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Phase 5 — ClickBank INS v8. Register POST https://YOUR_DOMAIN/api/clickbank/ins
CLICKBANK_INS_SECRET=

# Phase 9 — single-operator admin. Required in production.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# INTERNAL_FRAME_SECRET=

# Optional web search used only after the original product URL is blocked
# (HTTP 403 / access denied / robots / anti-bot). Never used to bypass that URL.
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_PROVIDER=serpapi
# WEB_SEARCH_PROVIDER=none
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# Market research freshness for strategy selection (hours). Default 24.
# MARKET_RESEARCH_MAX_AGE_HOURS=24

# Object storage (only when MEDIA_STORAGE=OBJECT_STORAGE)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
